    - target: {fileID: 1944835760268397292, guid: 78805b74923983c499f134cef43699cb, type: 3}
      propertyPath: m_Name
      value: P_MENU
      objectReference: {fileID: 0}
    - target: {fileID: 2142202057325228033, guid: 78805b74923983c499f134cef43699cb, type: 3}
      propertyPath: m_text
      value: "\n\nNie sprawia mi przyjemno\u015Bci trzymanie no\u017Ca na pa\u0144skim
        gardle, ale ka\u017Cdy z nas robi to co musi, nie to co chce. Jedyne co musisz
        zrobi\u0107 to odebra\u0107 pewn\u0105 paczk\u0119, dostarczy\u0107 j\u0105
        naszemu cz\u0142owiekowi i spe\u0142ni\u0107 instrukcje kt\xF3re ci przeka\u017Ce\u2026
        \r\n\r\nWyjd\u017A z hotelu i kieruj si\u0119 w stron\u0119 Babilonu. Szukaj
        placu ze straganami. Jak znajdziesz paczk\u0119 przeczytaj karteczk\u0119
        po dalsze instrukcje. Nie zwlekaj. Cienie s\u0105 ci dzi\u015B sojusznikiem,
        ale noc nie b\u0119dzie trwa\u0142a wiecznie\u2026\r\n\r\nPrzyjaciel.\r"
      objectReference: {fileID: 0}
