  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- 1 puszka czerwonej fasoli\r\n\r\n- 1 cebula (je\u015Bli dost\u0119pna)\r\n\r\n-
    1 kostka bulionowa klasy E (lub ekstrakt z glon\xF3w)\r\n\r\n- szczypta pieprzu
    czarnego lub syntetycznego\r\n\r\nPrzygotowanie:\r\nPodsma\u017C cebul\u0119
    na suchej patelni (do momentu pojawienia si\u0119 dymu), wrzu\u0107 fasol\u0119
    i zalej 2 szklankami wody. Dodaj bulion i gotuj 15 minut. Dopraw pieprzem, podawaj
    z chrupkiem bia\u0142kowym.\r\n\r\nUwaga: idealna na nocne zmiany \u2013 wysokoenergetyczna
    i lekko dra\u017Cni\u0105ca. Dzia\u0142a lepiej ni\u017C kawa."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 457b2217545ab574789c1caa7d049949, type: 2}
  m_sharedMaterial: {fileID: -2813006760094683958, guid: 457b2217545ab574789c1caa7d049949, type: 2}
