  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Z redakcji Echo Ulic\r\n22:00 \u2013 Sektor 4, Zewn\u0119trzny Pier\u015Bcie\u0144\nWczorajsza
    noc by\u0142a spokojniejsza ni\u017C zwykle \u2013 i w\u0142a\u015Bnie to budzi
    najwi\u0119kszy niepok\xF3j. Gdy neonowe znaki zgas\u0142y na chwil\u0119 o 02:13,
    wielu mieszka\u0144c\xF3w spojrza\u0142o w niebo. Nic nie zobaczyli. I mo\u017Ce
    to dobrze.\r\n\r\nMinisterstwo Porz\u0105dku zapewnia, \u017Ce \u201Ewszystko
    funkcjonuje w granicach normy\u201D, jednak plotki o zak\u0142\xF3ceniach w Centrum
    Sygna\u0142\xF3w pojawiaj\u0105 si\u0119 coraz cz\u0119\u015Bciej. Przypadek?
    Kolejny test? A mo\u017Ce po prostu miasto oddycha \u2013 ci\u0119\u017Cko, nier\xF3wno,
    jak przed burz\u0105.\n\nW magazynach brakuje miedzi i izoterm, a dostawy z P\xF3\u0142nocnego
    Bloku op\xF3\u017Aniaj\u0105 si\u0119 ju\u017C trzeci dzie\u0144 z rz\u0119du.
    Robotnicy Sektora 6 donosz\u0105 o dziwnym szumie wydobywaj\u0105cym si\u0119
    spod powierzchni ulic \u2013 niekt\xF3rzy twierdz\u0105, \u017Ce to tylko instalacje
    ch\u0142odz\u0105ce. Inni, \u017Ce to co\u015B wi\u0119cej."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 457b2217545ab574789c1caa7d049949, type: 2}
  m_sharedMaterial: {fileID: -2813006760094683958, guid: 457b2217545ab574789c1caa7d049949, type: 2}
