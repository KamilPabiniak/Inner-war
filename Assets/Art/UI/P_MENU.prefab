      m_Calls: []
  m_text: "Z pocz\u0105tkiem tygodnia jednostki A.D.A.M. (Androidy Dzia\u0142a\u0144
    Automatycznych i Militarnych) otrzyma\u0142y najnowsz\u0105 aktualizacj\u0119
    systemow\u0105. Dzi\u0119ki niej androidy mog\u0105 teraz samodzielnie zabezpiecza\u0107
    sektor miejski bez potrzeby ingerencji ludzkiej. Dow\xF3dztwo raportuje znacz\u0105cy
    wzrost wydajno\u015Bci i dyscypliny w\u015Br\xF3d oddzia\u0142\xF3w - \u017Co\u0142nierze
    nie s\u0105 ju\u017C zmuszani do nocnych zmian, co wp\u0142ywa na og\xF3ln\u0105
    gotowo\u015B\u0107 bojow\u0105.\r\nMaszyna nie \u015Bpi. Maszyna chroni."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 457b2217545ab574789c1caa7d049949, type: 2}
