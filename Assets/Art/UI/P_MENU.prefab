--- !u!1001 &163745073152501577
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1276385103856406614}
    m_Modifications:
    - target: {fileID: 2305592514121471816, guid: e89336370bdf62b448d12ef17c850fc1, type: 3}
      propertyPath: m_text
      value: "\n\nNie sprawia mi przyjemno\u015Bci trzymanie no\u017Ca na pa\u0144skim
        gardle, ale jest jak jest. Wykonasz dla nas pewne zadanie, doko\u0144czysz
        stare porachunki, pewne osoby wr\xF3c\u0105 do ciebie bezpiecznie, inne wylec\u0105
        w powietrze, a miasto b\u0119dzie lepszym miejscem bez pewnego drania. Wszyscy
        zyskaj\u0105, a jedyne co musisz zrobi\u0107 to odebra\u0107 pewn\u0105 paczk\u0119,
        dostarczy\u0107 j\u0105 naszemu cz\u0142owiekowi i pakunek kt\xF3ry Ci da
        po\u0142o\u017Cy\u0107 pod \u015Bcian\u0105 pewnego wysokiego budynku\u2026
        \n\r\nPo wyj\u015Bciu z hotelu skieruj si\u0119 na prawo, za przej\u015Bciem
        znajdziesz plac od kt\xF3rego odbija kolejny - mniejszy i os\u0142oni\u0119ty
        po prawej stronie. Tak w cieniu przej\u015Bcia znajdziesz przedmiot kt\xF3ry
        b\u0119dziesz musia\u0142 zanie\u015B\u0107. Nie zwlekaj. Cienie s\u0105
        ci dzi\u015B sojusznikiem, ale noc nie b\u0119dzie trwa\u0142a wiecznie\u2026\r\n\nPrzyjaciel."
      objectReference: {fileID: 0}
    - target: {fileID: 4170911758768099901, guid: e89336370bdf62b448d12ef17c850fc1, type: 3}
      propertyPath: m_text
      value: Drogi Abelardzie Pavor,
      objectReference: {fileID: 0}
    - target: {fileID: 5338575199509856480, guid: e89336370bdf62b448d12ef17c850fc1, type: 3}
      propertyPath: 'm_Materials.Array.data[0]'
