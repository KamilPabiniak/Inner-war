      m_Calls: []
  m_text: "Min\u0105\u0142 rok od momentu, gdy Najwy\u017Cszy Przew\xF3dca Seth Gaster
    obj\u0105\u0142 w\u0142adz\u0119 nad Arhknoir. Dla uczczenia tego prze\u0142omowego
    wydarzenia, dzi\u015B o 20:00 w siedzibie K.A.I.N. odb\u0119dzie si\u0119 zamkni\u0119ta
    uroczysto\u015B\u0107 dla wybranych.\r\nUwaga: wst\u0119p wy\u0142\u0105cznie
    za okazaniem oficjalnego zaproszenia.\r\nChwa\u0142a Przew\xF3dcy. Chwa\u0142a
    jedno\u015Bci."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 457b2217545ab574789c1caa7d049949, type: 2}
  m_sharedMaterial: {fileID: -637873146101574673, guid: 457b2217545ab574789c1caa7d049949, type: 2}
