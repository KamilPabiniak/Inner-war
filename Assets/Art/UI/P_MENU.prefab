  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Gazowe maski pozostaj\u0105 nieod\u0142\u0105cznym elementem \u017Cycia
    codziennego mieszka\u0144c\xF3w Arhknoir. Pomimo dzia\u0142a\u0144 K.A.I.N. i
    post\u0119p\xF3w w zabezpieczaniu granic, stan powietrza wci\u0105\u017C przekracza
    poziom krytyczny. Dow\xF3dztwo ostrzega: wszelkie spekulacje o zniesieniu obostrze\u0144
    s\u0105 przedwczesne.\r\nZachowaj czujno\u015B\u0107. Oddychaj bezpiecznie.\n"
  m_isRightToLeft: 0
